<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!-- Консольный аппендер -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level [%c{1}] %msg%n"/>
        </Console>
        <File name="CoderFile" fileName="logs/coder.log" append="false">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level [%c{1}] %msg%n"/>
        </File>

    </Appenders>

    <Loggers>
        <!-- Логгер для собственного кода -->
        <Logger name="dstu.csae.rs_code.RSFCoder" level="debug" additivity="false">
            <AppenderRef ref="CoderFile"/>
        </Logger>


        <!-- Корневой логгер -->
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
